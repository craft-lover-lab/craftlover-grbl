{
  "name": "craftlover-grbl",
  "version": "0.1.0",
  "description": "Free, open-source design & control software for GRBL 1.1 laser engravers and cutters",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/craft-lover-lab/craftlover-grbl.git"
  },
  "main": "dist/main/main.js",
  "private": true,
  "scripts": {
    "build:main": "esbuild src/main/main.ts src/main/preload.ts --bundle --platform=node --format=cjs --outdir=dist/main --external:electron --external:serialport",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "typecheck": "tsc --noEmit -p .",
    "start": "npm run build && electron .",
    "dev": "npm run build:main && concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "clipper-lib": "^6.4.2",
    "opentype.js": "^2.0.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@types/clipper-lib": "^6.4.0",
    "@types/node": "^26.6.6",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.4.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wait-on": "^9.5.1"
  }
}
